@app.route('/upload_image', methods=['POST'])
def upload_image():
    try:
        if 'image' not in request.files:
            add_log('ERROR', 'No image file in request')
            return jsonify({'status': 'error', 'message': 'No image file'}), 400
        
        file = request.files['image']
        
        if file.filename == '':
            add_log('ERROR', 'Empty filename')
            return jsonify({'status': 'error', 'message': 'Empty filename'}), 400
        
        timestamp = datetime.now().strftime('%Y%m%d_%H%M%S')
        filename = f"photo_{timestamp}_{uuid.uuid4().hex[:8]}.jpg"
        filepath = os.path.join(UPLOAD_FOLDER, filename)
        
        file.save(filepath)
        
        add_log('INFO', f"Image uploaded", f"Filename: {filename}, Size: {os.path.getsize(filepath)} bytes")
        
        return jsonify({
            'status': 'ok',
            'message': 'Image uploaded',
            'image_path': filepath,
            'timestamp': datetime.now().isoformat()
        }), 201
        
    except Exception as e:
        add_log('ERROR', f"Error uploading image: {str(e)}")
        return jsonify({'status': 'error', 'message': str(e)}), 500

@app.route('/analyze_image', methods=['POST'])
def analyze_image():
    try:
        if not AI_AVAILABLE or model is None:
            return jsonify({
                'status': 'error',
                'message': 'AI model not available. Install TensorFlow and train a model.'
            }), 503
        
        data = request.get_json()
        
        if not data:
            return jsonify({'status': 'error', 'message': 'No JSON data'}), 400
        
        image_data = data.get('image')
        
        if not image_data:
            return jsonify({'status': 'error', 'message': 'No image data'}), 400
        
        image_array = preprocess_image(image_data)
        
        if image_array is None:
            return jsonify({'status': 'error', 'message': 'Failed to process image'}), 400
        
        analysis_result = analyze_plant_health(image_array)
        
        prediction = {
            'id': len(ai_predictions) + 1,
            'timestamp': datetime.now().isoformat(),
            'image_id': data.get('image_id', str(uuid.uuid4())),
            'diagnosis': analysis_result['diagnosis'],
            'confidence': analysis_result['confidence'],
            'disease_type': analysis_result.get('disease_type'),
            'recommendations': analysis_result.get('recommendations')
        }
        ai_predictions.append(prediction)
        
        add_log('INFO', f"AI analysis completed", 
                f"Diagnosis: {analysis_result['diagnosis']}, Confidence: {analysis_result['confidence']:.2f}")
        
        return jsonify({
            'status': 'ok',
            'message': 'Image analyzed',
            'result': analysis_result,
            'prediction_id': prediction['id'],
            'analyzed_at': datetime.now().isoformat()
        }), 200
        
    except Exception as e:
        add_log('ERROR', f"Error analyzing image: {str(e)}")
        return jsonify({'status': 'error', 'message': str(e)}), 500

@app.route('/ml_result', methods=['POST'])
def receive_ml_result():
    try:
        data = request.get_json()
        
        if not data:
            add_log('ERROR', 'No JSON data received for ML result')
            return jsonify({'status': 'error', 'message': 'No JSON data'}), 400
        
        image_id = data.get('image_id')
        diagnosis = data.get('diagnosis')
        confidence = data.get('confidence')
        
        if image_id is None or diagnosis is None:
            add_log('ERROR', 'Missing image_id or diagnosis', str(data))
            return jsonify({'status': 'error', 'message': 'Missing image_id or diagnosis'}), 400
        
        result = {
            'id': len(ml_results) + 1,
            'image_id': image_id,
            'diagnosis': diagnosis,
            'confidence': confidence,
            'received_at': datetime.now().isoformat()
        }
        ml_results.append(result)
        
        add_log('INFO', f"ML result received", 
                f"Image: {image_id}, Diagnosis: {diagnosis}, Confidence: {confidence}")
        
        if diagnosis != 'healthy':
            add_log('WARNING', f"Unhealthy plant detected", 
                    f"Image: {image_id}, Diagnosis: {diagnosis}")
        
        return jsonify({
            'status': 'ok',
            'message': 'ML result received',
            'received_at': datetime.now().isoformat()
        }), 201
        
    except Exception as e:
        add_log('ERROR', f"Error processing ML result: {str(e)}")
        return jsonify({'status': 'error', 'message': str(e)}), 500

