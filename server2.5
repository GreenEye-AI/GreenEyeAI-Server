from flask import Flask, request, jsonify
from flask_cors import CORS
import logging
from datetime import datetime
import os
import uuid
import base64
from io import BytesIO
from PIL import Image
import numpy as np

try:
    import tensorflow as tf
    from tensorflow.keras.models import load_model
    from tensorflow.keras.applications.mobilenet_v2 import preprocess_input
    AI_AVAILABLE = True
except ImportError:
    AI_AVAILABLE = False
    print("Warning: TensorFlow not installed. AI features disabled.")

logging.basicConfig(
    level=logging.INFO,
    format='%(asctime)s - %(levelname)s - %(message)s',
    handlers=[
        logging.FileHandler('server.log', encoding='utf-8'),
        logging.StreamHandler()
    ]
)

app = Flask(__name__)
CORS(app)

UPLOAD_FOLDER = 'uploads'
MODEL_FOLDER = 'models'
if not os.path.exists(UPLOAD_FOLDER):
    os.makedirs(UPLOAD_FOLDER)
if not os.path.exists(MODEL_FOLDER):
    os.makedirs(MODEL_FOLDER)

sensor_readings = []
ml_results = []
ai_predictions = []

model = None

def load_ai_model():
    global model
    if not AI_AVAILABLE:
        return None
    
    model_path = os.path.join(MODEL_FOLDER, 'plant_disease_model.h5')
    
    if os.path.exists(model_path):
        try:
            model = load_model(model_path)
            logging.info("AI model loaded successfully")
            return model
        except Exception as e:
            logging.error(f"Error loading model: {str(e)}")
            return None
    else:
        logging.warning("No AI model found. Creating a simple model for demo.")
        try:
            model = create_simple_model()
            return model
        except Exception as e:
            logging.error(f"Error creating model: {str(e)}")
            return None

def create_simple_model():
    if not AI_AVAILABLE:
        return None
    
    from tensorflow.keras.models import Sequential
    from tensorflow.keras.layers import Conv2D, MaxPooling2D, Flatten, Dense, Dropout
    
    model = Sequential([
        Conv2D(32, (3, 3), activation='relu', input_shape=(128, 128, 3)),
        MaxPooling2D(2, 2),
        Conv2D(64, (3, 3), activation='relu'),
        MaxPooling2D(2, 2),
        Conv2D(128, (3, 3), activation='relu'),
        MaxPooling2D(2, 2),
        Flatten(),
        Dense(512, activation='relu'),
        Dropout(0.5),
        Dense(3, activation='softmax')
    ])
    
    model.compile(optimizer='adam', loss='categorical_crossentropy', metrics=['accuracy'])
    
    dummy_input = np.zeros((1, 128, 128, 3))
    model.predict(dummy_input)
    
    logging.info("Simple demo model created")
    return model

def preprocess_image(image_data):
    try:
        if isinstance(image_data, str):
            if image_data.startswith('data:image'):
                image_data = image_data.split(',')[1]
            image_bytes = base64.b64decode(image_data)
            image = Image.open(BytesIO(image_bytes))
        elif isinstance(image_data, bytes):
            image = Image.open(BytesIO(image_data))
        else:
            image = image_data
        
        image = image.resize((128, 128))
        image_array = np.array(image)
        
        if len(image_array.shape) == 2:
            image_array = np.stack([image_array] * 3, axis=-1)
        elif image_array.shape[2] == 4:
            image_array = image_array[:, :, :3]
        
        image_array = preprocess_input(image_array)
        image_array = np.expand_dims(image_array, axis=0)
        
        return image_array
    except Exception as e:
        logging.error(f"Error preprocessing image: {str(e)}")
        return None

def analyze_plant_health(image_array):
    global model
    
    if model is None or not AI_AVAILABLE:
        return {
            'diagnosis': 'unknown',
            'confidence': 0.5,
            'disease_type': 'model_not_available',
            'recommendations': 'AI model not available. Please check installation.'
        }
    
    try:
        predictions = model.predict(image_array)
        predicted_class = np.argmax(predictions[0])
        confidence = float(np.max(predictions[0]))
        
        classes = ['healthy', 'diseased', 'nutrient_deficiency']
        
        if classes[predicted_class] == 'healthy':
            diagnosis = 'healthy'
            disease_type = None
            recommendations = 'Plant appears healthy. Continue regular care.'
        elif classes[predicted_class] == 'diseased':
            diagnosis = 'diseased'
            disease_type = 'bacterial_or_fungal_infection'
            recommendations = 'Isolate plant. Remove affected leaves. Apply appropriate treatment.'
        else:
            diagnosis = 'nutrient_deficiency'
            disease_type = 'nutrient_imbalance'
            recommendations = 'Check pH levels. Adjust nutrient solution. Monitor EC levels.'
        
        return {
            'diagnosis': diagnosis,
            'confidence': confidence,
            'disease_type': disease_type,
            'recommendations': recommendations,
            'predicted_class': predicted_class
        }
    except Exception as e:
        logging.error(f"Error in AI analysis: {str(e)}")
        return {
            'diagnosis': 'error',
            'confidence': 0,
            'disease_type': 'analysis_error',
            'recommendations': f'Error during analysis: {str(e)}'
        }

def add_log(level, message, details=None):
    if level == 'INFO':
        logging.info(message)
    elif level == 'WARNING':
        logging.warning(message)
    elif level == 'ERROR':
        logging.error(message)
    return None

@app.route('/data', methods=['POST'])
def receive_data():
    try:
        data = request.get_json()
        
        if not data:
            add_log('ERROR', 'No JSON data received')
            return jsonify({'status': 'error', 'message': 'No JSON data received'}), 400
        
        sensor = data.get('sensor')
        value = data.get('value')
        unit = data.get('unit')
        
        if sensor is None or value is None:
            add_log('ERROR', 'Missing sensor or value', str(data))
            return jsonify({'status': 'error', 'message': 'Missing sensor or value'}), 400
        
        reading = {
            'id': len(sensor_readings) + 1,
            'sensor': sensor,
            'value': value,
            'unit': unit,
            'received_at': datetime.now().isoformat()
        }
        sensor_readings.append(reading)
        
        add_log('INFO', f"Sensor data received: {sensor}={value}{unit}", 
                f"Total readings: {len(sensor_readings)}")
        
        return jsonify({
            'status': 'ok',
            'message': 'Data received',
            'received_at': datetime.now().isoformat()
        }), 201
        
    except Exception as e:
        add_log('ERROR', f"Error processing data: {str(e)}")
        return jsonify({'status': 'error', 'message': str(e)}), 500

